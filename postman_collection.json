{
  "info": {
    "name": "Unwoldam Studio - Tarot API",
    "description": "Complete API collection for Unwoldam Studio Tarot Card AI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "unwoldam-studio"
  },
  "auth": {
    "type": "bearer",
